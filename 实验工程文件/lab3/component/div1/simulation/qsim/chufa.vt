always @(denom0 or denom1 or denom2 or denom3 or denom4 or denom5 or denom6 or denom7 or denom8 or denom9 or denom10 or denom11 or denom12 or denom13 or denom14 or denom15 or divclk or numerator0 or numerator1 or numerator2 or numerator3 or numerator4 or numerator5 or numerator6 or numerator7 or numerator8 or numerator9 or numerator10 or numerator11 or numerator12 or numerator13 or numerator14 or numerator15)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
